# Copy this file to `.env` and fill in the values:  cp .env.example .env
# `.env` is git-ignored. Never commit real credentials.

# MongoDB Atlas connection string (Atlas UI → Connect → Drivers).
# Replace <db_username> and <db_password> with your database user.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>.mongodb.net/?appName=<cluster-name>

# OpenRouter API key (openrouter.ai → Keys → Create API Key).
OPENROUTER_API_KEY=sk-or-v1-...
